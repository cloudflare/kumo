---
import DocLayout from "../../layouts/DocLayout.astro";
import Heading from "../../components/docs/Heading.astro";
import ComponentSection from "../../components/docs/ComponentSection.astro";
import ComponentExample from "../../components/docs/ComponentExample.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import PropsTable from "../../components/docs/PropsTable.astro";
import {
  DrawerHeroDemo,
  DrawerHorizontalSheetsDemo,
  DrawerVerticalSheetsDemo,
} from "../../components/demos/DrawerDemo";
---

<DocLayout
  title="Drawer"
  description="Sliding panel for side sheets and bottom-sheet interactions."
  sourceFile="components/drawer"
  baseUIComponent="drawer"
>
  <ComponentSection>
    <ComponentExample
      code={`<Drawer.Root>
  <Drawer.Trigger render={(props) => <Button {...props}>Open Drawer</Button>} />
  <Drawer className="p-6">
    <Drawer.Title>Edit Settings</Drawer.Title>
    <Drawer.Description>Configure workspace settings before saving.</Drawer.Description>
    <Drawer.Actions>
      <Drawer.Close render={(props) => <Button variant="secondary" {...props}>Cancel</Button>} />
      <Drawer.Close render={(props) => <Button {...props}>Save</Button>} />
    </Drawer.Actions>
  </Drawer>
</Drawer.Root>`}
    >
      <DrawerHeroDemo client:load />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <Heading level={2}>Installation</Heading>
    <Heading level={3} class="mb-2 text-lg">Barrel</Heading>
    <CodeBlock code={`import { Drawer } from "@cloudflare/kumo";`} lang="tsx" />
    <h3 class="mt-4 mb-2 text-lg font-semibold">Granular</h3>
    <CodeBlock
      code={`import { Drawer } from "@cloudflare/kumo/components/drawer";`}
      lang="tsx"
    />
  </ComponentSection>

  <ComponentSection>
    <Heading level={2}>Usage</Heading>
    <CodeBlock
      code={`import { Button, Drawer } from "@cloudflare/kumo";

export default function Example() {
  return (
    <Drawer.Root>
      <Drawer.Trigger render={(props) => <Button {...props}>Open Drawer</Button>} />
      <Drawer className="p-6">
        <Drawer.Title>Drawer title</Drawer.Title>
        <Drawer.Description>Drawer content</Drawer.Description>
        <Drawer.Actions>
          <Drawer.Close render={(props) => <Button variant="secondary" {...props}>Cancel</Button>} />
          <Drawer.Close render={(props) => <Button {...props}>Save</Button>} />
        </Drawer.Actions>
      </Drawer>
    </Drawer.Root>
  );
}`}
      lang="tsx"
    />
  </ComponentSection>

  <ComponentSection>
    <Heading level={2} class="mb-6">Examples</Heading>
    <div class="space-y-8">
      <div>
        <Heading level={3}>Horizontal Sheets (Right + Left)</Heading>
        <ComponentExample
          code={`<Drawer.Root swipeDirection="left">
  <Drawer.Trigger render={(props) => <Button {...props}>Open Left Sheet</Button>} />
  <Drawer swipeDirection="left" className="p-6">
    <Drawer.Title>Navigation</Drawer.Title>
    <Drawer.Description>Left-side sheet.</Drawer.Description>
    <Drawer.Actions>
      <Drawer.Close render={(props) => <Button variant="secondary" {...props}>Cancel</Button>} />
      <Drawer.Close render={(props) => <Button {...props}>Save</Button>} />
    </Drawer.Actions>
  </Drawer>
</Drawer.Root>

<Drawer.Root>
  <Drawer.Trigger render={(props) => <Button {...props}>Open Right Sheet</Button>} />
  <Drawer className="p-6">
    <Drawer.Title>Edit Settings</Drawer.Title>
    <Drawer.Description>Right-side sheet.</Drawer.Description>
    <Drawer.Actions>
      <Drawer.Close render={(props) => <Button variant="secondary" {...props}>Cancel</Button>} />
      <Drawer.Close render={(props) => <Button {...props}>Save</Button>} />
    </Drawer.Actions>
  </Drawer>
</Drawer.Root>`}
        >
          <DrawerHorizontalSheetsDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>Vertical Sheets (Top + Bottom)</Heading>
        <ComponentExample
          code={`<Drawer.Root swipeDirection="up">
  <Drawer.Trigger render={(props) => <Button {...props}>Open Top Sheet</Button>} />
  <Drawer swipeDirection="up" className="p-6">
    <Drawer.Title>Announcement</Drawer.Title>
    <Drawer.Description>Top sheet for global notices and quick actions.</Drawer.Description>
    <Drawer.Actions>
      <Drawer.Close render={(props) => <Button variant="secondary" {...props}>Dismiss</Button>} />
      <Drawer.Close render={(props) => <Button {...props}>Acknowledge</Button>} />
    </Drawer.Actions>
  </Drawer>
</Drawer.Root>

<Drawer.Root swipeDirection="down">
  <Drawer.Trigger render={(props) => <Button {...props}>Open Bottom Sheet</Button>} />
  <Drawer swipeDirection="down" className="p-6">
    <Drawer.Title>Filters</Drawer.Title>
    <Drawer.Description>Bottom sheet for focused actions.</Drawer.Description>
    <Drawer.Actions>
      <Button variant="secondary">Reset</Button>
      <Drawer.Close render={(props) => <Button {...props}>Apply</Button>} />
    </Drawer.Actions>
  </Drawer>
</Drawer.Root>`}
        >
          <DrawerVerticalSheetsDemo client:load />
        </ComponentExample>
      </div>

    </div>
  </ComponentSection>

  <ComponentSection>
    <Heading level={2}>API Reference</Heading>
    <PropsTable component="Drawer" />
  </ComponentSection>
</DocLayout>
