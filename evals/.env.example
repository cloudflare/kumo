# Cloudflare AI Gateway credentials (preferred; same org secrets used by Bonk).
# Create `.env.local` at the repository root with these values.
CF_AI_GATEWAY_ACCOUNT_ID=your-account-id
CF_AI_GATEWAY_NAME=your-gateway-name
CF_AI_GATEWAY_TOKEN=your-gateway-token

# Optional: fallback direct Workers AI credentials if AI Gateway is not configured.
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_KEY=your-api-key
